import { useEffect, useRef } from 'react';

interface CurrencyInputProps {
  id: string;
  label: string;
  help: string;
  value: number;
  step?: number;
  onChange: (value: number) => void;
}

export function CurrencyInput({ id, label, help, value, step = 500, onChange }: CurrencyInputProps) {
  const inputRef = useRef<HTMLInputElement>(null);
  const isFocusedRef = useRef(false);

  function formatDisplay(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString('es-ES');
  }

  // Sync committed value to input when NOT focused
  useEffect(() => {
    if (!isFocusedRef.current && inputRef.current) {
      inputRef.current.value = formatDisplay(value);
    }
  }, [value]);

  function handleFocus() {
    isFocusedRef.current = true;
    if (inputRef.current) {
      inputRef.current.value = '';
    }
  }

  function handleBlur() {
    isFocusedRef.current = false;
    const raw = inputRef.current?.value ?? '';
    const cleaned = raw.replace(/[^0-9]/g, '');
    if (cleaned === '' || cleaned === '0') {
      onChange(0);
      if (inputRef.current) inputRef.current.value = '0';
      return;
    }
    const parsed = Number(cleaned);
    if (isNaN(parsed) || parsed < 0) {
      onChange(0);
      if (inputRef.current) inputRef.current.value = '0';
      return;
    }
    const rounded = Math.round(parsed / step) * step;
    onChange(rounded);
    if (inputRef.current) inputRef.current.value = formatDisplay(rounded);
  }

  function handleKeyDown(e: React.KeyboardEvent) {
    if (e.key === 'Enter') {
      handleBlur();
      inputRef.current?.blur();
    }
  }

  return (
    <div className="input-group">
      <label htmlFor={id}>{label}</label>
      <input
        ref={inputRef}
        id={id}
        type="text"
        inputMode="numeric"
        pattern="[0-9]*"
        onFocus={handleFocus}
        onBlur={handleBlur}
        onKeyDown={handleKeyDown}
      />
      <p className="input-help">{help}</p>
    </div>
  );
}
